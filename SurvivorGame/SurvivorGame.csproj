<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Artes\Inimigos\ratoselvagem.xp" />
    <None Remove="Artes\Icones\icon_apple.xp" />
    <None Remove="Artes\Icones\icon_armor.xp" />
    <None Remove="Artes\Icones\icon_weapon.xp" />
    <None Remove="Artes\Cenarios\mapa_inicio_teste.xp" />
    <None Remove="Artes\Cenarios\location2.xp" />
    <None Remove="Artes\Extras\knife.xp" />
    <None Remove="Artes\Extras\npc_test.xp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Se o "dotnet restore" não achar essas versões exatas, atualizem para as mais
         recentes listadas em https://www.nuget.org/packages/SadConsole -->
    <PackageReference Include="SadConsole" Version="10.10.1" />
    <PackageReference Include="SadConsole.Extended" Version="10.10.1" />
    <PackageReference Include="SadConsole.Host.MonoGame" Version="10.10.1" />

    <!-- O SadConsole.Host.MonoGame só faz a "ponte" com o SadConsole; ele NÃO traz o
         motor MonoGame em si. Sem este pacote, a MonoGame.Framework.dll não existe
         e o jogo quebra em runtime com FileNotFoundException. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="SadRex" Version="1.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Artes\Inimigos\ratoselvagem.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Icones\icon_apple.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Icones\icon_armor.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Icones\icon_weapon.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Cenarios\mapa_inicio_teste.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Cenarios\location2.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Extras\knife.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Artes\Extras\npc_test.xp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="Artes\Inimigos\caoassilvestrado.xp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Artes\Inimigos\enxamedemosquitos.xp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Artes\Inimigos\saqueador.xp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Artes\Inimigos\viralataalfa.xp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
